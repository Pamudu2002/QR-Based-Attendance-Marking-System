# Copy to .env and fill in. Never commit .env.

# Pooled connection (Neon "-pooler" host) used by the app at runtime.
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/attendance?sslmode=require"
# Direct connection used by `prisma migrate` (or DATABASE_URL_UNPOOLED). Optional for local Postgres.
DIRECT_URL=""

# Key for the pseudonyms in the experiment export. Falls back to JWT_SECRET.
EXPORT_PSEUDONYM_KEY=""

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=""

# Comma-separated email domains allowed to sign up as lecturers. Empty = any.
ALLOWED_LECTURER_DOMAINS="uom.lk"
