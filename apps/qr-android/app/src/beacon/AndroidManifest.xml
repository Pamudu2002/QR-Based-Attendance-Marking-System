<?xml version="1.0" encoding="utf-8"?>
<!-- CSE Attendance Beacon: the lecturer's phone broadcasts the classroom beacon (PLAN §6.5). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+: Nearby devices (broadcast). 6–11: BLUETOOTH / BLUETOOTH_ADMIN from main. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
    <!-- Runs while the phone sits on the desk: a foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Lets the connectedDevice service start before Nearby devices is granted (Android 14+). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- From the shared biometric library; the beacon key needs no fingerprint. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:name=".beacon.BeaconApp"
        tools:replace="android:label"
        android:label="@string/beacon_app_name">
        <activity
            android:name=".beacon.BeaconActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".beacon.BeaconService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
